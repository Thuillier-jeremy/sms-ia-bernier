# Anthropic API
# Obtenir la clé sur https://console.anthropic.com/keys
VITE_ANTHROPIC_API_KEY=sk-ant-...

# M-Target API
# Obtenir depuis votre dashboard M-Target
VITE_MTARGET_API_KEY=votre-clé-mtarget
VITE_MTARGET_SENDER_PROFILE=BERNIER

# Optionnel : URL de l'API M-Target (si différente du défaut)
VITE_MTARGET_API_URL=https://api.m-target.com/v1/sms/send

# Optionnel : Pour la réception des SMS (webhook)
VITE_WEBHOOK_SECRET=votre-secret-webhook
